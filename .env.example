# ============================================================================
# 画面の設定(見本)。このファイルをコピーして「.env」という名前にし、値を入れる。
#   .env は .gitignore で GitHub に上がらないようにしてある。★ .env.example に本物の鍵を書かない。
#
# 値の取り方(Supabase の画面): 左メニュー「Project Settings」→「API」
#   ※ 2026-09-09 時点の私の記憶。画面の位置は開いて確かめること(未確認)
#   Project URL           → VITE_SUPABASE_URL
#   Project API keys の anon public → VITE_SUPABASE_ANON_KEY
#   (service_role は絶対に画面に入れない。RLS を通り抜けて全社のデータが見えてしまう)
# ============================================================================

# 本物の Supabase に繋ぐとき
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ここに anon public の長い文字列

# ログインを許す会社ドメイン(Google ログインの hd パラメータ。本当の門番は Supabase 側の RLS)
VITE_ALLOWED_DOMAIN=seikou-seimitsu.com

# 偽データモード: 1 にすると Supabase に繋がず src/mock/ の JSON を表示する(鍵が無くても動く)
# 本物に繋ぐときは 0 にするか、この行を消す
VITE_MOCK=1
